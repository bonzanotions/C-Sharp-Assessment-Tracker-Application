<Window x:Class="AssessmentTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Assessment Tracker" Height="560" Width="860" MinHeight="420" MinWidth="720"
        WindowStartupLocation="CenterScreen" Closing="Window_Closing">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Filter bar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Filter by:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="FilterFieldComboBox" Width="100" Margin="0,0,8,0"
                      SelectionChanged="FilterFieldComboBox_SelectionChanged"/>
            <TextBox x:Name="FilterTextBox" Width="220" Margin="0,0,8,0" VerticalContentAlignment="Center"
                     TextChanged="FilterTextBox_TextChanged" ToolTip="Type to filter the lists"/>
            <Button x:Name="ClearFilterButton" Content="Clear Filter" Padding="10,3" Click="ClearFilterButton_Click"/>
        </StackPanel>

        <!-- Current and completed assessments -->
        <TabControl x:Name="ListsTabControl" Grid.Row="1">
            <TabItem Header="Current Assessments">
                <DataGrid x:Name="CurrentDataGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" CanUserAddRows="False" HeadersVisibility="Column"
                          MouseDoubleClick="DataGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Unit/Cluster" Binding="{Binding Unit}" Width="*"/>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="*"/>
                        <DataGridTextColumn Header="Due Date" Binding="{Binding DueDateText}" Width="100"/>
                        <DataGridTextColumn Header="Grade" Binding="{Binding Grade}" Width="60"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Completed Assessments">
                <DataGrid x:Name="CompletedDataGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" CanUserAddRows="False" HeadersVisibility="Column"
                          MouseDoubleClick="DataGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Unit/Cluster" Binding="{Binding Unit}" Width="*"/>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="*"/>
                        <DataGridTextColumn Header="Due Date" Binding="{Binding DueDateText}" Width="100"/>
                        <DataGridTextColumn Header="Grade" Binding="{Binding Grade}" Width="60"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="AddButton" Content="Add Assessment" Padding="12,5" Margin="0,0,8,0"
                    Click="AddButton_Click"/>
            <Button x:Name="EditButton" Content="Edit Assessment" Padding="12,5" Margin="0,0,8,0"
                    Click="EditButton_Click"/>
            <Button x:Name="DeleteButton" Content="Delete Assessment" Padding="12,5" Margin="0,0,24,0"
                    Click="DeleteButton_Click"/>
            <Button x:Name="LoadButton" Content="Load from File" Padding="12,5" Margin="0,0,8,0"
                    Click="LoadButton_Click"/>
            <Button x:Name="SaveButton" Content="Save to File" Padding="12,5" Margin="0,0,24,0"
                    Click="SaveButton_Click"/>
            <Button x:Name="ExitButton" Content="Exit" Padding="12,5" Click="ExitButton_Click"/>
        </StackPanel>

        <!-- Status bar -->
        <TextBlock x:Name="StatusTextBlock" Grid.Row="3" Margin="0,8,0,0" Foreground="DimGray"/>
    </Grid>
</Window>
