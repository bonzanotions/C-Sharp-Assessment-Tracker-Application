<Window x:Class="AssessmentTrackerWPF.wndDeleteAssess"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AssessmentTrackerWPF"
        mc:Ignorable="d"
        Title="Delete Assessments" Height="450" Width="800">
    <Grid>
        <ListView ItemContainerStyle="{DynamicResource ListViewItemContainerStyleView}" x:Name="lstNovSearchAssess" d:ItemsSource="{d:SampleData ItemCount=10}" Margin="10,100,10,60" Foreground="Black" FontFamily="Calibri" FontSize="14" SelectionChanged="lstViewAssess_SelectionChanged">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="ID" DisplayMemberBinding="{Binding Id}" Width="50"/>
                    <GridViewColumn Header="Unit/Cluster" DisplayMemberBinding="{Binding UnitCluster}" Width="150"/>
                    <GridViewColumn Header="Assessment" DisplayMemberBinding="{Binding AssessmentName}" Width="120"/>
                    <GridViewColumn Header="Type" DisplayMemberBinding="{Binding AssessmentType}" Width="170"/>
                    <GridViewColumn Header="Due Date" DisplayMemberBinding="{Binding DueDate, StringFormat=MM-dd-yyyy}" Width="110"/>
                    <GridViewColumn Header="Grade" DisplayMemberBinding="{Binding Grade}" Width="70"/>
                </GridView>
            </ListView.View>
        </ListView>
        <Button x:Name="btnMainMenu" Content="Return To Menu" HorizontalAlignment="Left" Height="24" Margin="40,20,0,0" VerticalAlignment="Top" Width="110" Background="#FFE8C5C5" Click="btnMainMenu_Click"/>
        <Button x:Name="btnDelAssEnter" Content="Delete Assessment" HorizontalAlignment="Right" Height="24" Margin="0,0,40,20" VerticalAlignment="Bottom" Width="135" Click="btnDelAssEnter_Click"/>
        <TextBox x:Name="txtSearch" HorizontalAlignment="Left" Margin="10,60,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="567" Height="24"/>
        <Button x:Name="btnSearchEnter" Content="Search" HorizontalAlignment="Right" Height="24" Margin="0,60,40,0" VerticalAlignment="Top" Width="135" Click="btnSearchEnter_Click"/>
        <Button x:Name="btnChangeSearchType" Content="Change Search Type" HorizontalAlignment="Right" Height="24" Margin="0,20,40,0" VerticalAlignment="Top" Width="135" Click="btnChangeSearchType_Click"/>
        <Label x:Name="lblSearchType" Content="General Search - Type Anything" HorizontalAlignment="Left" Margin="168,20,0,0" VerticalAlignment="Top" Width="409" Height="35"/>

    </Grid>
</Window>
