<Window x:Class="AssessmentTrackerWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AssessmentTrackerWPF"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" HorizontalContentAlignment="Center">
    <Grid>
        <Label Content="Main Menu" HorizontalAlignment="Center" Height="40" Margin="0,10,0,0" VerticalAlignment="Top" Width="780" FontSize="24" HorizontalContentAlignment="Center"/>
        <Button x:Name="btnViewAssess" Content="View Assessments" HorizontalAlignment="Center" Height="24" Margin="0,-160,0,0" VerticalAlignment="Center" Width="200" FontFamily="Arial" Background="#FFEFDAC1" BorderBrush="Black" Click="btnViewAssess_Click"/>
        <Button x:Name="btnAddAssess" Content="Add Assessments" HorizontalAlignment="Center" Height="24" Margin="0,-80,0,0" VerticalAlignment="Center" Width="200" FontFamily="Arial" Background="#FFDCEDCD" BorderBrush="Black" Click="btnAddAssess_Click"/>
        <Button x:Name="btnDelAssess" Content="Delete Assessments" HorizontalAlignment="Center" Height="24" Margin="0,0,0,0" VerticalAlignment="Center" Width="200" FontFamily="Arial" Background="#FFE8C5C5" BorderBrush="Black" Click="btnDelAssess_Click"/>
        <Button x:Name="btnEditAssess" Content="Edit Assessments" HorizontalAlignment="Center" Height="24" Margin="0,80,0,0" VerticalAlignment="Center" Width="200" FontFamily="Arial" Background="#FFCEC5E8" BorderBrush="Black" Click="btnEditAssess_Click"/>
        <Button x:Name="btnExit" Content="Exit" HorizontalAlignment="Center" Height="24" Margin="0,160,0,0" VerticalAlignment="Center" Width="200" FontFamily="Arial" Background="#FFE3C5E8" BorderBrush="Black" Click="btnExit_Click"/>
    </Grid>
</Window>
